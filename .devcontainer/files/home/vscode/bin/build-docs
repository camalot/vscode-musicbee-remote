#!/usr/bin/env bash

# Resolve the workspace root: prefer git (works anywhere inside the repo),
# then scan /workspaces/* (standard VS Code devcontainer mount), then
# fall back to the legacy /workspace path used during the Docker image build.
function get_workspace_root() {
  local git_root
  git_root=$(git rev-parse --show-toplevel 2>/dev/null)
  if [ -n "$git_root" ]; then
    echo "$git_root"
    return
  fi
  # Scan /workspaces/* — devcontainer mounts land here
  if [ -d "/workspaces" ]; then
    local ws
    ws=$(find /workspaces -maxdepth 1 -mindepth 1 -type d 2>/dev/null | head -1)
    [ -n "$ws" ] && { echo "$ws"; return; }
  fi
  # Legacy / fallback path
  echo "/workspace"
}

function build() {
  local WATCH=$1
  # save the current working directory
  local OLDPWD
  OLDPWD=$(pwd)

  # set the working directory to <workspace>/docs
  local WORKSPACE_ROOT
  WORKSPACE_ROOT=$(get_workspace_root)
  cd "$WORKSPACE_ROOT/docs" || exit

  bundle install

  bundle exec jekyll build --destination ../_site "$WATCH" || {
    echo "Jekyll build failed"
    cd "$OLDPWD" || exit
    exit 1
  }

  # return to the original working directory
  cd "$OLDPWD" || exit
}

function serve() {
  local WATCH=$1
  local OLDPWD
  OLDPWD=$(pwd)

  local WORKSPACE_ROOT
  WORKSPACE_ROOT=$(get_workspace_root)
  cd "$WORKSPACE_ROOT/docs" || exit
  bundle exec jekyll serve --destination ../_site --config _config.yml,_config-local.yml --skip-initial-build "$WATCH"
  cd "$OLDPWD" || exit
}

# loop over all args passed and run the corresponding commands
for arg in "$@"; do
  case $arg in
  --build)
    build
    ;;
  --buildw)
    build "--watch"
    ;;
  --serve)
    serve
    ;;
  --servew)
    serve "--watch"
    ;;
  *)
    build
    ;;
  esac
done
